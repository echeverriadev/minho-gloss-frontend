# URL de la API (backend). El navegador la llama directamente.
# Si se deja vacía, se usa el mismo host desde el que se abre la app en el puerto 3000
# (sirve para localhost, 127.0.0.1 o la IP de la red local desde el celular).
VITE_API_URL=

# Formato regional (ver la spec product-scope). Opcionales.
VITE_APP_LOCALE=es-ES
VITE_APP_CURRENCY=EUR
VITE_APP_TIMEZONE=Europe/Lisbon
